# Run python3 scripts/setup.py to generate .env with random passwords.
ADMIN_USER=admin
ADMIN_PASSWORD=
BRIDGE_TOKEN=
# No real call/push until explicitly enabled. UI labels this mode clearly.
DELIVERY_ENABLED=false
# URL reachable from your iPhone, e.g. https://alerts.example.com (TLS proxy required).
PUBLIC_URL=http://localhost:8787
BARK_SERVER=https://api.day.app
# Optional: Device Key can also be saved in the dashboard.
# 旧 Key 仅作为外出模式的兼容配置
BARK_DEVICE_KEY=
BARK_HOME_DEVICE_KEY=
BARK_AWAY_DEVICE_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Data retention. Labels survive cleanup; unlabelled text expires.
RETENTION_DAYS=14

# Optional separate origin for signed confirmation links; default: PUBLIC_URL.
# Public proxy MUST expose only GET/POST /confirm and GET /confirm/client.js.
CONFIRMATION_URL=
